# ---- Hackwise environment ----
# Copy this file to `.env.local` and fill in your values. `.env.local` is gitignored.
# Without GEMINI_API_KEY the app runs in clearly-labeled DEMO MODE (no live analysis).

# Your Google Gemini API key (server-side only; never exposed to the browser).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use. Leave this unset unless you have a reason to pin one.
# Default (if unset): gemini-flash-lite-latest — an alias for the current lite Flash
# model, chosen because the full-size Flash models are frequently overloaded (HTTP 503).
# Whatever you set here is tried FIRST; if it is overloaded or unavailable, the server
# automatically falls back through other Flash models (see lib/gemini.mjs > FALLBACK_MODELS),
# so analysis keeps working. Pin a specific model only to force one, e.g. gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# Max characters of extracted page text sent to the model (controls latency/cost).
# Default (if unset): 16000
MAX_PAGE_CHARS=16000

# Reader proxy used when a site blocks direct server-side fetches (e.g. Devpost/Cloudflare).
# Default is https://r.jina.ai/ . Set to empty to disable the fallback.
# READER_PROXY=https://r.jina.ai/

# Timeouts in milliseconds (optional; raise only on a slow network).
# FETCH_TIMEOUT_MS  — how long to wait for the hackathon page (default 12000).
# GEMINI_TIMEOUT_MS — how long to wait for the model response (default 60000).
# FETCH_TIMEOUT_MS=12000
# GEMINI_TIMEOUT_MS=60000
